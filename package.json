{
  "name": "frame-health-landing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/preorder-stripe-hardening.test.mjs tests/preorder-local-gate.test.mjs tests/preorder-tax-policy.test.mjs tests/preorder-numbering.test.mjs tests/admin-email-safety.test.mjs tests/automated-email-previews.test.mjs tests/admin-time-zone-clock.test.mjs && tsx --test tests/meta-tracking.test.mts tests/landing-diagnostics.test.mts tests/waitlist-unsubscribe.test.mjs tests/preorder-email-design.test.mjs tests/automated-email-design.test.mjs tests/company-details.test.mjs tests/preorder-stripe-account-readiness.test.mjs tests/preorder-email-readiness.test.mjs tests/preorder-payment-reconciliation.test.mjs tests/preorder-operations-health.test.mjs tests/preorder-email-delivery-events.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "release:check": "node scripts/check-release-source.mjs",
    "preorder:check": "tsx scripts/check-preorder-readiness.mjs",
    "preorder:check:email": "tsx scripts/check-preorder-email-readiness.mjs",
    "preorder:check:payments": "tsx scripts/check-preorder-payment-reconciliation.mjs",
    "preorder:check:payments:test": "tsx scripts/check-preorder-payment-reconciliation.mjs --test",
    "preorder:check:operations": "tsx scripts/check-preorder-operations-health.mjs",
    "preorder:check:operations:test": "tsx scripts/check-preorder-operations-health.mjs --test",
    "preorder:check:staging": "tsx scripts/check-preorder-readiness.mjs --staging",
    "preorder:check:live-smoke": "tsx scripts/check-preorder-readiness.mjs --live-smoke",
    "preorder:check:launch": "tsx scripts/check-preorder-readiness.mjs --launch",
    "preorder:test:reliability": "node scripts/test-preorder-reliability.mjs",
    "preorder:test:visibility": "node --test tests/preorder-local-gate.test.mjs",
    "preorder:staging-link": "node scripts/create-preorder-staging-link.mjs",
    "preorder:live-smoke-link": "node scripts/create-preorder-live-smoke-link.mjs",
    "db:generate": "drizzle-kit generate",
    "creative:v2": "node scripts/generate-frame-creatives-v2.mjs",
    "creative:facebook": "node scripts/generate-frame-facebook-ads-v1.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "drizzle-orm": "0.45.2",
    "fflate": "0.7.4",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
